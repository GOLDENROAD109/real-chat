# ── Server ──────────────────────────────────────────────────────────────
PORT=3000
# Secret used to sign session tokens — change this in production!
JWT_SECRET=change-me-to-a-long-random-string

# ── Supabase (optional) ─────────────────────────────────────────────────
# Leave these blank to run in built-in demo mode (local JSON database).
# Fill them in to persist users + messages in your Supabase project.
# 1. Create a project at https://supabase.com
# 2. Run supabase/schema.sql in the SQL editor
# 3. Copy Project URL + service_role key from Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Demo mode ───────────────────────────────────────────────────────────
# Seed demo accounts (admin/admin123, alice/alice123, bob/bob123) on first run.
# Set to "false" to disable.
SEED_DEMO=true
